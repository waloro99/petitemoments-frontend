{
  "name": "petitemoments-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-build-secret.mjs && next dev",
    "build": "node scripts/ensure-build-secret.mjs --force && next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed-sql": "node --experimental-strip-types --no-warnings scripts/build-seed-sql.ts",
    "typecheck": "node scripts/ensure-build-secret.mjs && tsc --noEmit",
    "admin:password": "node scripts/admin-password.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "aws4fetch": "^1.0.20",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "22.x"
  }
}
