# Copia este archivo como .env.local y completa los valores.
# Sin las variables de Supabase, el sitio corre en MODO DEMO con los datos del prototipo.

# URL pública del sitio (sin "/" final). En Vercel: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (base de datos) → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave pública: "Publishable key" (sb_publishable_...) o la clásica "anon public"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta, SOLO servidor: "Secret key" (sb_secret_...) o la clásica "service_role".
# Nunca la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Cadena aleatoria para hashear IPs en el rate limit de reseñas y cotizaciones
RATE_LIMIT_SALT=cambia-esto-por-una-cadena-larga-aleatoria

# Correo de contacto que se muestra en el sitio y recibe los avisos (placeholder: confirmar con la clienta)
NEXT_PUBLIC_CONTACT_EMAIL=hola@petitemomentsgt.com

# Aviso por correo de cada cotización (opcional). https://resend.com → API Keys
RESEND_API_KEY=
# Remitente verificado en Resend. Para pruebas puedes usar onboarding@resend.dev
RESEND_FROM=Petite Moments <onboarding@resend.dev>
# A quién llega el aviso (si se omite, usa NEXT_PUBLIC_CONTACT_EMAIL)
LEAD_NOTIFY_EMAIL=

# Panel administrativo (opcional: si no se definen, se usa el usuario por defecto)
# Genera el hash con: npm run admin:password -- "tu-nueva-contraseña"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Secreto para firmar la sesión (opcional; si falta, se genera uno en cada build)
ADMIN_SESSION_SECRET=

# Imágenes en Cloudflare R2 (recomendado: 10 GB gratis, sin costo de salida).
# Si se dejan vacías, las imágenes se guardan en Supabase Storage (1 GB gratis).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=petitemoments-media
# Dominio público conectado al bucket, sin "/" final
R2_PUBLIC_URL=https://media.tudominio.com

# Protege el cron diario /api/keepalive (Vercel lo envía automáticamente si existe)
CRON_SECRET=
